# Copiar a .env y ajustar. Un valor vacío usa el valor por defecto.

# ---- Motor de arbitraje ----
INITIAL_CAPITAL_CLP=1000000
MAX_STEPS=5
TOP_ROUTES=3
MIN_NET_PROFIT_CLP=0
# % que se empeora cada tasa antes de calcular la ganancia neta (SPEC §27)
SAFETY_MARGIN_PERCENT=0
# Estados conservados por divisa y paso en la búsqueda (más = más exhaustivo y lento)
SEARCH_BEAM_WIDTH=100
# Rutas candidatas que se evalúan con distancia/transporte antes de elegir el Top
CANDIDATE_ROUTES=50
TIMEZONE=America/Santiago

# ---- Calidad de datos ----
# Más antigua que esto: baja la confianza (sigue usándose)
MAX_QUOTE_AGE_MINUTES=10
# Más antigua que esto: no se usa para detectar (queda en el historial)
MAX_QUOTE_USABLE_HOURS=24
MAX_PUBLISHED_AGE_DAYS=14
# % de desvío respecto de la mediana de otras casas para marcar ANOMALOUS_QUOTE
ANOMALY_THRESHOLD_PERCENT=15
ANOMALY_MIN_PEERS=3

# Dólar de mercado (USDT/CLP) como referencia en /precios y alertas; vacío = desactivado
MARKET_REFERENCE=binance,buda
MARKET_GAP_PERCENT=0.3
MARKET_ALERT_COOLDOWN_HOURS=6

# Diferencia de USDT entre plataformas (comprar en una, vender en otra); vacío = desactivado
USDT_VENUES=buda,binance,okx
# Criptos a comparar entre esas plataformas
CRYPTO_ASSETS=USDT,BTC,ETH,USDC
USDT_FEE_PERCENT=0
USDT_ALERT_COOLDOWN_HOURS=2
# API de precios que se leen aunque su robots.txt lo pida (autorizado por John el 2026-10-07)
ROBOTS_EXEMPT_APIS=binance,buda,cryptomkt,bybit,okx
# Historial de lecturas USDT para /backtest
USDT_HISTORY_FILE=data/usdt_prices.csv

# Resumen diario "lo más cerca de un arbitraje" (hora local); vacío = no enviar
NEAR_MISS_REPORT_TIME=19:00

# Aviso diario de casas que dejaron de dar precios (hora local); vacío = no enviar
HEALTH_REPORT_TIME=11:00
HEALTH_STALE_HOURS=2

# ---- Comisión estimada manual, si la casa no publica la suya (vacío = desconocida) ----
DEFAULT_COMMISSION_PERCENT=
DEFAULT_COMMISSION_FIXED_CLP=

# ---- Transporte: walk | public_transport | car | taxi ----
TRANSPORT_MODE=public_transport
TRANSPORT_COST_PER_KM=0
TRANSPORT_FIXED_COST_PER_TRIP_CLP=0
# Cobrar la ida desde ORIGIN y la vuelta (true) o solo los traslados entre casas (false)
TRANSPORT_FROM_HOME=true
# Costo alternativo por viaje, solo informativo (p. ej. taxi): "Si vas en taxi: +$X"
TRANSPORT_ALT_COST_PER_TRIP_CLP=
TRANSPORT_ALT_LABEL=taxi
# km/h promedio (vacío = valor por defecto del modo: 4.5 / 18 / 22 / 22)
TRANSPORT_SPEED_KMH=
# distancia real ≈ línea recta × factor (si no hay OSRM)
ROUTE_DISTANCE_FACTOR=1.3
# Servidor OSRM opcional para distancias por calle, p. ej. https://router.project-osrm.org
OSRM_URL=
# Punto de partida (opcional): python scripts/geocode_branches.py --origin "Calle 123, Comuna"
ORIGIN_LAT=
ORIGIN_LON=
MINUTES_PER_OPERATION=10

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# No repetir la misma ruta antes de este tiempo, salvo que mejore ALERT_MIN_IMPROVEMENT_PERCENT
ALERT_COOLDOWN_MINUTES=60
ALERT_MIN_IMPROVEMENT_PERCENT=10
# Avisar de nuevo si la ganancia de una ruta ya avisada baja este % o más (0 = no avisar)
ALERT_DROP_PERCENT=10

# ---- Seguimiento ----
# DETECTED / PENDING_VERIFICATION sin revisar pasan a EXPIRED después de N minutos
OPPORTUNITY_TTL_MINUTES=60

# ---- Infraestructura ----
# SQLite por defecto (data/arbitraje.db). PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/arbitraje
DATABASE_URL=
LOG_LEVEL=INFO
LOOP_INTERVAL_SECONDS=180
# Más seguido al abrir las casas (hora local); vacío = siempre LOOP_INTERVAL_SECONDS
FAST_LOOP_WINDOW=09:00-10:30
FAST_LOOP_INTERVAL_SECONDS=60
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Obligatorio si expones el panel a Internet: abrir con http://host:8000/?token=...
DASHBOARD_TOKEN=

# ---- Scrapers ----
# Slugs separados por coma (ver `python -m app.main scrapers`).
# Disponibles: manual_csv, web_discovery, gamaex, cambios_lyon, inmonex, brollano,
# cambio_costero, more_exchange, cambios_santiago, orion, afex (los cuatro últimos necesitan Playwright).
# Revisa todos de una vez con `python -m app.main probe-all` antes de activarlos.
ENABLED_SCRAPERS=manual_csv,web_discovery
# web_discovery: busca precios en la web de cada casa registrada sin scraper propio.
# Un sitio sin precios se vuelve a revisar cada estas horas.
DISCOVERY_RETRY_HOURS=24

# Búsqueda de casas nuevas en el mapa. El loop la repite cada MAPS_DISCOVERY_DAYS;
# también: python -m app.main discover-maps
# MAPS_PROVIDER: auto = Google Maps si hay GOOGLE_MAPS_API_KEY, si no OpenStreetMap (gratis, sin clave).
MAPS_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
MAPS_QUERIES=casas de cambio;casa de cambio
MAPS_BBOX=-33.65,-70.85,-33.30,-70.45
MAPS_MAX_REQUESTS=300
MAPS_DISCOVERY_DAYS=30
DISCOVERY_USE_BROWSER=true
# Pedido diario por Telegram: enlaces de WhatsApp con la pregunta escrita para las casas sin
# precio reciente (el bot no les escribe; tú envías). Vacío = no enviar.
PRICE_REQUEST_TIME=
PRICE_REQUEST_CURRENCIES=USD,EUR,BRL,ARS,PEN
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_RETRIES=2
SCRAPER_BACKOFF_SECONDS=2
RESPECT_ROBOTS_TXT=true
